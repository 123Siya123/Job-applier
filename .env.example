# =============================================================
# Job-Applier — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================

# --- Brain (Gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-pro
GEMINI_VISION_MODEL=gemini-3.1-pro

# --- Actor backend: "playwright" (default) or "openclaw" ---
ACTOR_BACKEND=playwright

# --- Browser (only when ACTOR_BACKEND=playwright) ---
BROWSER_HEADED=true
BROWSER_CHANNEL=chromium
BROWSER_SLOW_MO_MS=120

# --- OpenClaw (only when ACTOR_BACKEND=openclaw) ---
OPENCLAW_HOST=127.0.0.1
OPENCLAW_PORT=4711
OPENCLAW_TIMEOUT_SECONDS=60

# --- Email Monitoring (IMAP) ---
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=you@example.com
EMAIL_IMAP_PASSWORD=your-app-password
EMAIL_POLL_INTERVAL_MINUTES=120

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/applier.sqlite3

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# --- Orchestrator ---
TARGET_COMPANY_COUNT=50
APPLICATION_DAILY_LIMIT=200
SOURCING_DAILY_LIMIT=300
GLOBAL_RATE_LIMIT_RPS=2.0

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./data/applier.log
